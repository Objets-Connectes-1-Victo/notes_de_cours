site_name: "Notes de cours - Objets connectÃ©s 1 (420-3A4-VI)"
theme:
  name: material
  language: fr
  palette:
    - scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: Passer au mode sombre
    - scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: Passer au mode clair
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - navigation.indexes
    - search.suggest
    - search.highlight
    - content.code.copy

extra_css:
  - stylesheets/extra.css

markdown_extensions:
  - admonition
  - attr_list
  - md_in_html
  - tables
  - toc:
      permalink: true
  - pymdownx.details
  - pymdownx.superfences
  - pymdownx.highlight:
      anchor_linenums: true
      line_spans: __span
      pygments_lang_class: true
  - pymdownx.inlinehilite
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.emoji

plugins:
  - search

nav:
  - Notes de cours: index.md
  - Chapitres regroupÃ©s:
    - "Chapitres 1-1": "001_010_merged.md"
    - "Chapitres 2-2": "021_030_merged.md"
    - "Chapitres 3-3": "031_040_merged.md"
    - "Chapitres 4-5": "041_050_merged.md"
    - "Chapitres 6-7": "061_070_merged.md"
    - "Chapitres 8-8": "071_080_merged.md"
    - "Chapitres 9-9": "081_090_merged.md"
    - "Chapitres 10-11": "101_110_merged.md"
    - "Chapitres 12-13": "111_120_merged.md"
    - "Chapitres 14-14": "121_130_merged.md"
  - 

