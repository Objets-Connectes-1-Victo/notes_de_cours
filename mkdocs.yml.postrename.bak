site_name: "Notes de cours - Objets connectes 1 (420-3A4-VI)"
theme:
  name: material
  language: fr
  palette:
    - scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: Passer au mode sombre
    - scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: Passer au mode clair
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - navigation.indexes
    - search.suggest
    - search.highlight
    - content.code.copy

extra_css:
  - stylesheets/extra.css

markdown_extensions:
  - admonition
  - attr_list
  - md_in_html
  - tables
  - toc:
      permalink: true
  - pymdownx.details
  - pymdownx.superfences
  - pymdownx.highlight:
      anchor_linenums: true
      line_spans: __span
      pygments_lang_class: true
  - pymdownx.inlinehilite
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.emoji

plugins:
  - search

nav:
  - Notes de cours: index.md
  - Chapitres regroupes:
    - "Chapitres 1-10": "001_010_merged.md"
    - "Chapitres 11-63": "011_063_merged.md"
    - "Chapitres 64-73": "064_073_merged.md"
    - "Chapitres 74-83": "074_083_merged.md"
    - "Chapitres 84-93": "084_093_merged.md"
    - "Chapitres 94-103": "094_103_merged.md"
    - "Chapitres 104-113": "104_113_merged.md"
    - "Chapitres 114-123": "114_123_merged.md"
    - "Chapitres 124-133": "124_133_merged.md"
    - "Chapitres 134-143": "134_143_merged.md"
